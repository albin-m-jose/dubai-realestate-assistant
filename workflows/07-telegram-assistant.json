        "query": "SELECT\n  (SELECT value FROM config WHERE key = 'agent_chat_id') AS agent_chat_id,\n  (SELECT hubspot_contact_id FROM customers WHERE chat_id = $1::bigint) AS contact_id,\n  (SELECT details FROM customers WHERE chat_id = $1::bigint) AS details,\n  (SELECT string_agg(\n            CASE WHEN direction = 'in' THEN 'Customer: ' ELSE 'Bot: ' END || coalesce(text, ''),\n            E'\\n' ORDER BY created_at)\n     FROM (SELECT direction, text, created_at\n           FROM messages\n           WHERE chat_id = $1::bigint\n           ORDER BY created_at DESC\n           LIMIT 6) m) AS recent;",
