    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO customers (chat_id, hubspot_contact_id, details)\nVALUES ($1::bigint, $2, $3::jsonb)\nON CONFLICT (chat_id) DO UPDATE\nSET hubspot_contact_id = EXCLUDED.hubspot_contact_id,\n    details = EXCLUDED.details,\n    updated_at = now()\nRETURNING hubspot_contact_id, hubspot_deal_id;",
        "options": {
          "queryReplacement": "={{ [ $('Prepare update').first().json.chat_id, $json.id, JSON.stringify($('Prepare update').first().json.details) ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
