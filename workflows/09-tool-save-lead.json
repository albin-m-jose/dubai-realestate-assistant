    {
      "parameters": {
        "jsCode": "const STAGE_QUALIFYING = 'qualifiedtobuy';        // replace with your Qualifying stage ID\nconst STAGE_QUALIFIED = 'presentationscheduled';  // replace with your Qualified stage ID\nconst PIPELINE = 'default';                       // replace with your pipeline ID\n\nconst p = $('Prepare update').first().json;\nconst row = $input.first().json;\nconst d = p.details;\n\nconst hasDeal = !!row.hubspot_deal_id;\nconst ready = !!d.intent && !!d.budget_aed;\nconst qualified = p.missing.length === 0;\nconst label = { rent: 'Rent', buy: 'Buy', invest: 'Invest' }[d.intent] || 'Enquiry';\nconst name = p.properties.firstname || 'Customer';\n\nreturn [{ json: {\n  action: hasDeal ? 'update' : (ready ? 'create' : 'none'),\n  contact_id: row.hubspot_contact_id,\n  deal_id: row.hubspot_deal_id,\n  pipeline: PIPELINE,\n  stage: qualified ? STAGE_QUALIFIED : STAGE_QUALIFYING,\n  dealname: `${label} - ${d.preferred_areas || 'Dubai'} - ${name}`,\n  amount: d.budget_aed || ''\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        592,
        -240
      ],
      "id": "922dda1b-88c5-41c6-b776-b18f5fdfd732",
      "name": "Deal rules"
    },
    {
      "parameters": {
        "jsCode": "const p = $('Prepare update').first().json;\nconst labels = {\n  intent: 'whether they want to buy, rent or invest',\n  budget_aed: 'maximum budget in AED',\n  timeline: 'timeline',\n  financing: 'financing (cash or mortgage)',\n  preferred_areas: 'preferred areas',\n  bedrooms: 'number of bedrooms'\n};\nconst missing = p.missing.map((k) => labels[k]);\n\nconst result = missing.length === 0\n  ? 'Saved. All details are collected. Tell the customer an agent will follow up.'\n  : `Saved. Still missing: ${missing.join(', ')}. Ask for ONE of these next, only if it fits the conversation.`;\n\nreturn [{ json: { result } }];"
      },
