      "name": "Is new customer?"
    },
    {
      "parameters": {
        "jsCode": "const input = $('When Executed by Another Workflow').first().json;\nconst row = $input.first().json;\n\nconst BLANK = ['', 'unknown', 'n/a', 'na', 'none', 'null', 'not provided', 'not specified'];\nconst clean = (v) => {\n  if (v === undefined || v === null) return '';\n  const s = String(v).trim();\n  return BLANK.includes(s.toLowerCase()) ? '' : s;\n};\n\nconst incoming = {\n  intent: clean(input.intent).toLowerCase(),\n  budget_aed: clean(input.budget_aed).replace(/[^0-9.]/g, ''),\n  preferred_areas: clean(input.preferred_areas),\n  bedrooms: clean(input.bedrooms),\n  timeline: clean(input.timeline),\n  financing: clean(input.financing),\n};\n\nconst old = row.details ? (typeof row.details === 'string' ? JSON.parse(row.details) : row.details) : {};\nconst details = { ...old };\nfor (const [k, v] of Object.entries(incoming)) {\n  if (v) details[k] = v;\n}\n\nconst WEIGHTS = details.intent === 'rent'\n  ? { budget_aed: 35, timeline: 30, preferred_areas: 20, bedrooms: 15 }\n  : { budget_aed: 30, timeline: 25, financing: 20, preferred_areas: 15, bedrooms: 10 };\n\nlet score = 0;\nconst missing = [];\nif (!details.intent) missing.push('intent');\nfor (const [k, w] of Object.entries(WEIGHTS)) {\n  if (details[k]) score += w; else missing.push(k);\n}\n\nconst isNew = !row.contact_id;\nconst properties = { ...details, telegram_chat_id: String(input.chat_id), lead_score: score };\nif (isNew) {\n  properties.firstname = clean(input.first_name) || 'Telegram customer';\n  properties.bot_status = 'active';\n}\n\nreturn [{ json: {\n  chat_id: String(input.chat_id),\n  is_new: isNew,\n  contact_id: row.contact_id,\n  details,\n  properties,\n  score,\n  missing\n} }];"
      },
