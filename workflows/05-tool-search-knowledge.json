      "credentials": {
        "googlePalmApi": {
          "id": "3mngNAotgWlGmBrR",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT json_agg(r ORDER BY r.similarity DESC) AS results\nFROM (\n  SELECT metadata->>'doc_title' AS doc_title,\n         metadata->>'section' AS section,\n         text,\n         round((1 - (embedding <=> $1::vector))::numeric, 3) AS similarity\n  FROM knowledge_chunks\n  ORDER BY embedding <=> $1::vector\n  LIMIT 4\n) r;",
        "options": {
          "queryReplacement": "={{ [ '[' + $json.embedding.values.join(',') + ']' ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        400,
        -96
      ],
      "id": "24cbfd4f-efeb-4bd6-a456-8dcb274113cf",
      "name": "Search knowledge",
      "credentials": {
        "postgres": {
          "id": "gODiF9cfszaS69lo",
          "name": "supabase-postgres"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const FLOOR = 0.55;\n\nlet results = $json.results;\nif (typeof results === 'string') results = JSON.parse(results);\n\nconst good = (results || []).filter((r) => Number(r.similarity) >= FLOOR);\n\nif (good.length === 0) {\n  return { json: { result: 'NO_RELEVANT_INFORMATION_FOUND' } };\n}\n\nconst text = good\n  .map((r, i) => `[Source ${i + 1}: ${r.doc_title} / ${r.section}]\\n${r.text}`)\n  .join('\\n\\n---\\n\\n');\n\nreturn { json: { result: text } };"
      },
      "type": "n8n-nodes-base.code",
